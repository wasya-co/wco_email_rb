
.email-campaigns-index.maxwidth
  .header
    %h5.title
      Email Campaigns (#{@campaigns.length})
      = link_to '[+]', new_email_campaign_path

  %table.bordered.padded
    %thead
      %tr
        %th actions
        %th active tag
        %th inactive tag
        %th tmpl
        %th status
        %th sent_at
    %tbody
      - @campaigns.each do |c|
        %tr
          %td
            = button_to 'send', wco_email.send_email_campaign_path(c), :data => { :confirm => 'Are you sure?' }
          %td= c.active_tag
          %td= c.inactive_tag
          %td= c.email_template
          %td= c.status
          %td= c.sent_at

